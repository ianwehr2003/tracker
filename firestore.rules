rules_version = '2';

// Each signed-in user can only read and write their own data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/data/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'updatedAt', 'device'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
    }
  }
}
